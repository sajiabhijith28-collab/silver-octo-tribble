PORT=3000
# Optional: comma-separated allowed frontend origins. Leave unset for simple local testing.
# CORS_ORIGIN=http://localhost:3000,https://your-domain.example

# Optional email notifications. Enquiries are saved to data/enquiries.json without SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
